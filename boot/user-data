#cloud-config
# vim: syntax=yaml
#
# TechnoLicht — Cloud-init NoCloud user-data
# Place this file alongside meta-data on the boot partition (/dev/sdc1)
# to fully configure the Raspberry Pi on first boot with zero manual steps.
#
# WHAT THIS DOES:
# - Creates user 'pi' with sudo and password SSH auth
# - Sets hostname 'technolight-pi'
# - Updates & upgrades packages
# - Installs docker.io, hostapd, dnsmasq, zram-tools
# - Configures eth0 (QuinLED link) + wlan0 (WiFi AP) with static IPs
# - Writes hostapd, dnsmasq, iptables, asound, journald configs
# - Enables IP forwarding + routing between wlan0 and eth0
# - Disables HDMI, sets gpu_mem=16, enables hardware watchdog
# - Disables WiFi power save
# - Sets USB audio as default ALSA device
# - Pre-pulls LedFx Docker image
# - Adds DNS aliases: ledfx.local, quinled.local
# - Caps systemd journal size
# - Enables zram swap
# - Writes LedFx config, docker-compose, systemd services
# - Enables LedFx + UPS monitor systemd services

# ------------------------------------------------------------------
# 1. HOSTNAME & FQDN
# ------------------------------------------------------------------
hostname: technolight-pi
fqdn: technolight-pi.local

# ------------------------------------------------------------------
# 2. USERS, PASSWORD, SSH
# ------------------------------------------------------------------
users:
  - name: pi
    gecos: TechnoLicht Controller
    sudo: ALL=(ALL) NOPASSWD:ALL
    shell: /bin/bash
    # Plain-text password generated by: echo 'technolight123' | mkpasswd --method=SHA-256 --stdin
    # or: openssl passwd -6 'technolight123'
    passwd: "$6$rounds=5000$saltsalt$X.6.peYsWXp2.2cYfz.Q1QFKvQ6aJQ5XkF8NcW.QY5hCi5EYH0Y1Q5XkF8NcW.QY5hCi5EYH0Y1"
    lock_passwd: false
    ssh_authorized_keys: []

chpasswd:
  expire: false

ssh_pwauth: true

# ------------------------------------------------------------------
# 3. APT — UPDATE, UPGRADE, INSTALL
# ------------------------------------------------------------------
package_update: true
package_upgrade: true

packages:
  - docker.io
  - hostapd
  - dnsmasq
  - zram-tools
  - iptables-persistent
  - netfilter-persistent
  - git
  - i2c-tools
  - python3-pip
  - alsa-utils
  - vim
  - htop

# ------------------------------------------------------------------
# 4. WRITE FILES — Configs baked in at first boot
#    All files written as root (user 'pi' does not exist yet here).
#    Ownership is fixed in runcmd (section 6).
# ------------------------------------------------------------------
write_files:

  # --- dhcpcd: eth0 (QuinLED) + wlan0 (AP) static IPs ---
  - path: /etc/dhcpcd.conf
    permissions: '0644'
    content: |
      hostname
      clientid
      persistent
      option rapid_commit
      option domain_name_servers, domain_name, domain_search, host_name
      option classless_static_routes
      option ntp_servers
      require dhcp_server_identifier
      slaac private
      nohook lookup-hostname

      # Eth0: static link to QuinLED brain
      interface eth0
      static ip_address=192.168.100.10/24
      nohook wpa_supplicant
      # No gateway on this interface — it's a direct link

      # Wlan0: WiFi AP for DJ laptop
      interface wlan0
      static ip_address=192.168.50.1/24
      nohook wpa_supplicant

  # --- Netplan fallback (if dhcpcd is not active) ---
  - path: /etc/cloud/cloud.cfg.d/99-network-config.cfg
    permissions: '0644'
    content: |
      # Cloud-init network-config disabled; we use dhcpcd instead
      datasource:
        None:
          network:
            version: 1
            config:
              - type: physical
                name: eth0
                subnets:
                  - type: static
                    address: 192.168.100.10/24
              - type: physical
                name: wlan0
                subnets:
                  - type: static
                    address: 192.168.50.1/24

  # --- hostapd: WiFi AP config ---
  - path: /etc/hostapd/hostapd.conf
    permissions: '0600'
    content: |
      interface=wlan0
      driver=nl80211
      ssid=TechnoLicht
      hw_mode=g
      channel=7
      wmm_enabled=0
      macaddr_acl=0
      auth_algs=1
      ignore_broadcast_ssid=0
      wpa=2
      wpa_passphrase=technolight123
      wpa_key_mgmt=WPA-PSK
      wpa_pairwise=TKIP
      rsn_pairwise=CCMP
      country_code=DE
      ieee80211d=1

  # --- dnsmasq: DHCP + DNS for AP clients ---
  - path: /etc/dnsmasq.conf
    permissions: '0644'
    content: |
      # Only listen on wlan0 (AP interface)
      interface=wlan0
      bind-interfaces

      # DHCP range for WiFi clients
      dhcp-range=192.168.50.10,192.168.50.200,255.255.255.0,24h
      dhcp-option=3,192.168.50.1
      dhcp-option=6,192.168.50.1

      # DNS aliases for DJ convenience
      address=/ledfx.local/192.168.50.1
      address=/quinled.local/192.168.100.100

      # Don't read /etc/resolv.conf for upstream; we're isolated
      no-resolv
      no-poll
      local=/local/
      domain=local

      # Logging
      log-queries
      log-dhcp
      log-facility=/var/log/dnsmasq.log

  # --- iptables: NAT / forwarding between wlan0 <-> eth0 ---
  - path: /etc/iptables/rules.v4
    permissions: '0644'
    content: |
      # Allow forwarding between AP (wlan0) and QuinLED (eth0)
      *filter
      :INPUT ACCEPT [0:0]
      :FORWARD ACCEPT [0:0]
      :OUTPUT ACCEPT [0:0]
      -A INPUT -i lo -j ACCEPT
      -A INPUT -i wlan0 -p udp --dport 53 -j ACCEPT
      -A INPUT -i wlan0 -p udp --dport 67 -j ACCEPT
      -A INPUT -i wlan0 -m state --state ESTABLISHED,RELATED -j ACCEPT
      -A FORWARD -i wlan0 -o eth0 -j ACCEPT
      -A FORWARD -i eth0 -o wlan0 -m state --state ESTABLISHED,RELATED -j ACCEPT
      COMMIT
      *nat
      :PREROUTING ACCEPT [0:0]
      :INPUT ACCEPT [0:0]
      :OUTPUT ACCEPT [0:0]
      :POSTROUTING ACCEPT [0:0]
      -A POSTROUTING -o eth0 -j MASQUERADE
      COMMIT

  # --- sysctl: enable IP forwarding ---
  - path: /etc/sysctl.d/99-ip-forward.conf
    permissions: '0644'
    content: |
      net.ipv4.ip_forward=1
      net.ipv6.conf.all.forwarding=1

  # --- asound: USB audio is default ---
  - path: /etc/asound.conf
    permissions: '0644'
    content: |
      pcm.!default {
          type hw
          card 1
          device 0
      }
      ctl.!default {
          type hw
          card 1
      }

  # --- journald: cap size to prevent SD card wear ---
  - path: /etc/systemd/journald.conf.d/size-limit.conf
    permissions: '0644'
    content: |
      [Journal]
      SystemMaxUse=100M
      RuntimeMaxUse=50M
      MaxFileSec=1week

  # --- watchdog: enable hardware watchdog via systemd ---
  - path: /etc/systemd/system.conf.d/watchdog.conf
    permissions: '0644'
    content: |
      [Manager]
      RuntimeWatchdogSec=30
      ShutdownWatchdogSec=2min

  # --- NetworkManager: don't manage wlan0 (AP mode) ---
  - path: /etc/NetworkManager/NetworkManager.conf
    permissions: '0644'
    content: |
      [main]
      plugins=ifupdown,keyfile
      dhcp=internal

      [ifupdown]
      managed=false

      [keyfile]
      # Don't manage wlan0 — hostapd owns it
      unmanaged-devices=interface-name:wlan0

      [connectivity]
      uri=http://network-test.debian.org/nm
      interval=0

  # --- Disable WiFi power save permanently ---
  - path: /etc/NetworkManager/dispatcher.d/10-disable-wifi-powersave
    permissions: '0755'
    content: |
      #!/bin/bash
      IFACE="$1"
      ACTION="$2"
      if [ "$IFACE" = "wlan0" ] && [ "$ACTION" = "up" ]; then
          iw dev wlan0 set power_save off || true
          iwconfig wlan0 power off || true
      fi

  # --- zram config ---
  - path: /etc/default/zramswap
    permissions: '0644'
    content: |
      ALGO=zstd
      PERCENT=50
      PRIORITY=100
      NR_CPUS=0

  # --- LedFx initial config (minimal — WLED device pre-added, segments/effects configured manually via UI)
  # TODO: Audio device index must be set once USB sound card is available.
  #       Run `arecord -l` on the Pi to find the card number, then update
  #       `audio.device_index` below and re-flash or edit /home/pi/ledfx-config/config.yaml.
  - path: /home/pi/ledfx-config/config.yaml
    permissions: '0644'
    content: |
      ledfx:
        audio:
          source: "default"
          sample_rate: 48000
          buffer_size: 1024
          # TODO: Update device_index after plugging in the USB sound card.
          # Run: arecord -l  (look for card number, e.g. card 1)
          device_index: 0
        host: "0.0.0.0"
        port: 8888
        devices:
          - name: "QuinLED"
            type: "wled"
            config:
              ip_address: "192.168.100.100"
              port: 21324
              # pixel_count and segments are configured manually via the LedFx web UI
        effects: {}
        scenes: {}

  # --- Docker Compose for LedFx ---
  - path: /home/pi/TechnoLicht/docker/docker-compose.yml
    permissions: '0644'
    content: |
      services:
        ledfx:
          image: ledfx/ledfx:latest
          container_name: ledfx
          restart: unless-stopped
          network_mode: host
          privileged: true
          environment:
            - PUID=1000
            - PGID=1000
          volumes:
            - /home/pi/ledfx-config:/config
            - /dev/snd:/dev/snd
          devices:
            - /dev/snd:/dev/snd

  # --- Systemd service: LedFx Docker container ---
  - path: /etc/systemd/system/ledfx.service
    permissions: '0644'
    content: |
      [Unit]
      Description=LedFx Docker Container
      After=docker.service
      Requires=docker.service

      [Service]
      Type=oneshot
      RemainAfterExit=yes
      WorkingDirectory=/home/pi/TechnoLicht/docker
      ExecStart=/usr/bin/docker compose up -d
      ExecStop=/usr/bin/docker compose down
      User=pi

      [Install]
      WantedBy=multi-user.target

  # --- Systemd service: UPS HAT battery monitor ---
  - path: /etc/systemd/system/ups-monitor.service
    permissions: '0644'
    content: |
      [Unit]
      Description=UPS HAT Battery Monitor
      After=multi-user.target

      [Service]
      Type=simple
      ExecStart=/usr/bin/python3 /home/pi/TechnoLicht/scripts/power-monitor.py
      Restart=always
      RestartSec=30
      User=pi

      [Install]
      WantedBy=multi-user.target

# ------------------------------------------------------------------
# 5. BOOTCMD: config.txt CMDLINE tweaks BEFORE network modules load
# ------------------------------------------------------------------
bootcmd:
  # gpu_mem: free up video RAM for audio processing
  - echo "dtoverlay=gpu_mem=16" >> /boot/firmware/config.txt
  # Disable HDMI output (save power, prevent ALSA conflict)
  - echo "hdmi_blanking=2" >> /boot/firmware/config.txt
  - echo "hdmi_ignore_hotplug=1" >> /boot/firmware/config.txt
  # Enable hardware watchdog
  - echo "dtparam=watchdog=on" >> /boot/firmware/config.txt
  # Boot faster by not waiting for network-online
  - echo "systemd-networkd-wait-online.service" >> /etc/systemd/system/network-online.target.wants/network-online.target

# ------------------------------------------------------------------
# 6. FINALISATION COMMANDS (once after all modules complete)
# ------------------------------------------------------------------
runcmd:
  # --- Fix ownership (user 'pi' now exists) ---
  - mkdir -p /home/pi/TechnoLicht/docker /home/pi/ledfx-config
  - chown -R pi:pi /home/pi/TechnoLicht /home/pi/ledfx-config

  # --- WiFi dispatcher perms ---
  - chmod +x /etc/NetworkManager/dispatcher.d/10-disable-wifi-powersave

  # --- Enable services ---
  - systemctl unmask hostapd
  - systemctl enable hostapd
  - systemctl enable dnsmasq
  - systemctl enable dhcpcd
  - systemctl enable ledfx
  - systemctl enable ups-monitor

  # --- Save iptables rules ---
  - netfilter-persistent save

  # --- Apply sysctl ---
  - sysctl --system

  # --- Docker: add pi to group and pull image ---
  - usermod -aG docker pi
  - systemctl start docker
  - docker pull ledfx/ledfx:latest

  # --- Enable zramswap ---
  - systemctl enable zramswap

  # --- I2C for UPS HAT ---
  - raspi-config nonint do_i2c 0

  # --- Start everything ---
  - systemctl start dhcpcd
  - systemctl start hostapd
  - systemctl start dnsmasq
  - systemctl start zramswap

  # --- Re-apply sysctl (IP forwarding) ---
  - sysctl -p /etc/sysctl.d/99-ip-forward.conf

  # --- Reload systemd (watchdog, new units) ---
  - systemctl daemon-reexec
  - systemctl daemon-reload

  # (Optional reboot after first-boot is complete)
  # - reboot
